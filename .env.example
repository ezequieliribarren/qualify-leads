# ── Base de datos ─────────────────────────────────────────────
# El schema se elige SOLO según esta URL (no hay que tocar nada más):
#
#   file:./dev.db     -> SQLite (desarrollo local, sin instalar nada)
#   mysql://...        -> MySQL (Hostinger u otro)
#   postgresql://...   -> PostgreSQL (Neon, Supabase)
#
# Local (por defecto):
DATABASE_URL="file:./dev.db"
#
# Hostinger MySQL:  mysql://USUARIO:CONTRASENA@HOST:3306/NOMBRE_DB
# Neon / Supabase:  postgresql://USUARIO:CONTRASENA@HOST/NOMBRE_DB?sslmode=require

# ── Auth.js / NextAuth ────────────────────────────────────────
# Generar con: openssl rand -base64 32   (o cualquier texto largo al azar)
NEXTAUTH_SECRET="cambiame-por-un-secreto-largo-y-aleatorio"
# Local: http://localhost:3000  ·  Producción: https://tudominio.com
NEXTAUTH_URL="http://localhost:3000"

# ── Webhook Evolution API (WhatsApp) ──────────────────────────
# Token compartido: Evolution lo manda en el header y el dashboard lo valida.
EVOLUTION_WEBHOOK_TOKEN="cambiame-token-webhook"

# ── Seed (usuarios que crean `npm run db:seed` y `db:seed:prod`) ─
# El "usuario" es un texto simple para el login (no hace falta que sea un email).
SEED_ADMIN_USUARIO="admin"
SEED_ADMIN_PASSWORD="admin1234"
SEED_VENDEDOR_USUARIO="vendedor"
SEED_VENDEDOR_PASSWORD="vende1234"
